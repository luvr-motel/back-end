  "info": {
    "title": "Luvr - Gestão Inteligente",
    "description": "Escola de T.I - software de gestão de motel.",
    "version": "1.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "API Luvr - BackEnd",
      "description": ""
    }
  ],
  "servers": [],
  "components": {
    "schemas": {
      "CreatePessoaDto": {
        "type": "object",
        "properties": {
          "pessoa_nome": {
            "type": "string",
            "example": "Maria da Silva",
            "maxLength": 255,
            "description": "Nome completo da pessoa."
          },
          "pessoa_cpf": {
            "type": "string",
            "example": "12345678901",
            "minLength": 11,
            "maxLength": 11,
            "pattern": "^\\d+$",
            "description": "CPF somente com dígitos (11 caracteres)."
          },
          "pessoa_telefone": {
            "type": "string",
            "example": "44999998888",
            "maxLength": 20,
            "pattern": "^\\d+$",
            "description": "Telefone somente com dígitos (até 20)."
          },
          "pessoatipo_id": {
            "type": "number",
            "example": 1,
            "description": "ID do tipo de pessoa (FK de pessoatipo)."
          }
        },
        "required": [
          "pessoa_nome",
          "pessoatipo_id"
        ]
      },
      "UpdatePessoaDto": {
        "type": "object",
        "properties": {
          "pessoa_nome": {
            "type": "string",
            "example": "Maria da Silva",
            "maxLength": 255,
            "description": "Nome completo da pessoa."
          },
          "pessoa_cpf": {
            "type": "string",
            "example": "12345678901",
            "minLength": 11,
            "maxLength": 11,
            "pattern": "^\\d+$",
            "description": "CPF somente com dígitos (11 caracteres)."
          },
          "pessoa_telefone": {
            "type": "string",
            "example": "44999998888",
            "maxLength": 20,
            "pattern": "^\\d+$",
            "description": "Telefone somente com dígitos (até 20)."
          },
          "pessoatipo_id": {
            "type": "number",
            "example": 1,
            "description": "ID do tipo de pessoa (FK de pessoatipo)."
          }
        }
      },
      "CreatePessoaTipoDto": {
        "type": "object",
        "properties": {
          "pessoatipo_descricao": {
            "type": "string",
            "example": "Funcionário",
            "maxLength": 255,
            "description": "Descrição do tipo de pessoa."
          }
        },
        "required": [
          "pessoatipo_descricao"
        ]
      },
      "UpdatePessoaTipoDto": {
        "type": "object",
        "properties": {
          "pessoatipo_descricao": {
            "type": "string",
            "example": "Funcionário",
            "maxLength": 255,
            "description": "Descrição do tipo de pessoa."
          }
        }
      },
      "CreateUsuarioDto": {
        "type": "object",
        "properties": {
          "usuarioCodigo": {
            "type": "string",
            "example": "max.v",
            "description": "Código único de login do usuário."
          },
          "usuarioSenha": {
            "type": "string",
            "example": "MUNDIAL2012CORINTHIANS",
            "description": "Senha em texto plano (será hasheada no servidor)."
          },
          "usuarioAtivo": {
            "type": "string",
            "enum": [
              "ativo",
              "inativo"
            ],
            "example": "ativo",
            "description": "Padrão ATIVO se omitido."
          },
          "pessoaId": {
            "type": "number",
            "example": 7,
            "description": "ID da Pessoa vinculada."
          },
          "motelId": {
            "type": "number",
            "example": 3,
            "description": "ID do Motel (quando habilitado)."
          },
          "usuarioRole": {
            "type": "string",
            "enum": [
              "admin",
              "gerente",
              "recepcionista"
            ],
            "example": "recepcionista",
            "description": "Papel do usuário."
          }
        },
        "required": [
          "usuarioCodigo",
          "usuarioSenha"
        ]
      },
      "UpdateUsuarioDto": {
        "type": "object",
        "properties": {}
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "usuarioCodigo": {
            "type": "string",
            "example": "rodrigo"
          },
          "senha": {
            "type": "string",
            "example": "senhadificildemaiscorinthians"
          }
        },
        "required": [
          "usuarioCodigo",
          "senha"
        ]
      }
    }
  }
}