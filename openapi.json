        "type": "object",
        "properties": {
          "motel_descricao": {
            "type": "string",
            "example": "LUVR Motel Centro",
            "maxLength": 255
          },
          "motel_endereco": {
            "type": "string",
            "example": "Av. Brasil, 1000 - Centro",
            "maxLength": 255
          },
          "motel_email": {
            "type": "string",
            "example": "contato@motel.com.br"
          },
          "motel_cnpj": {
            "type": "string",
            "example": "12.345.678/0001-99",
            "minLength": 11,
            "maxLength": 18
          },
          "motel_ativo": {
            "type": "string",
            "enum": [
              "ATIVO",
              "INATIVO"
            ],
            "default": "ATIVO"
          }
        },
        "required": [
          "motel_cnpj"
        ]
      },
